{
  "expo": {
    "name": "Wild Wash",
    "slug": "ww",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/ww logo.jpg",
    "scheme": "ww",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.kibeezy.ww",
      "icon": "./assets/images/ww logo.jpg"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/ww logo.jpg"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kibeezy.ww"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/ww logo.jpg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/ww logo.jpg",
          "imageWidth": 128
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "517de9ee-c611-4868-a94a-fa3b8dfcd471"
      }
    }
  }
}
